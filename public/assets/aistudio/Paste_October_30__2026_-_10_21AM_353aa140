-- 3. Crear una regla/función en Postgres que BLOQUEE la inserción de códigos aleatorios
CREATE OR REPLACE FUNCTION prevent_random_companies()
RETURNS TRIGGER AS $$
BEGIN
  IF NEW.id LIKE 'biz-bistroconta-pr-%' THEN
    RAISE EXCEPTION 'Operación cancelada: Se intentó crear una empresa con código aleatorio huérfano (%).', NEW.id;
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS tr_prevent_random_companies ON public.companies;

CREATE TRIGGER tr_prevent_random_companies
BEFORE INSERT ON public.companies
FOR EACH ROW
EXECUTE FUNCTION prevent_random_companies();
